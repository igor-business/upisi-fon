# Slanje prijava preko Mailgun-a (api/order.ts).
# Lokalno: kopiraj u .env.local i popuni. Na Vercelu: Project → Settings → Environment Variables.
# Bez MAILGUN_API_KEY, `npm run dev` samo ispiše mejl u terminalu, ništa se ne šalje.

# Privatni API ključ iz Mailgun-a (Settings → API Security).
MAILGUN_API_KEY=
# Domen za slanje, verifikovan u Mailgun-u (npr. mg.upisifon.rs). Sandbox domen šalje samo na odobrene adrese.
MAILGUN_DOMAIN=
# "eu" ako je domen u Mailgun-ovom EU regionu, inače ostaviti prazno (US).
MAILGUN_REGION=
# Ko prima prijave, odvojeno zarezom.
ORDER_EMAIL_TO=
# Opciono: pošiljalac. Podrazumevano "UpišiFON prijave <prijave@MAILGUN_DOMAIN>".
ORDER_EMAIL_FROM=
